# Optional — without this key the app uses deterministic mock outputs.
OPENAI_API_KEY=
# Optional OpenAI-compatible base (default api.openai.com). Include /v1.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# --- Supabase (用户+余额 MVP) — required for magic-link login + ledger ---
# Create a free project at https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser. Used for deduct_credit RPC.
SUPABASE_SERVICE_ROLE_KEY=
# After creating the project:
# 1) SQL Editor → run supabase/schema.sql
# 2) Auth → URL Configuration → Site URL = https://ai-web-workflow.vercel.app
#    Redirect URLs += http://localhost:3000/auth/callback
#                    += https://ai-web-workflow.vercel.app/auth/callback
# 3) Auth → Providers → Email enabled (magic link)
# 4) Paste the three keys into .env.local (and Vercel env) — do this in 1:1 with eng

# --- Test-only refund path (do NOT leave enabled casually) ---
# Option A: set FORCE_GENERATE_FAIL_SECRET to a long random string, then POST
#   /api/generate with header x-force-generate-fail: <same secret>
# Option B: FORCE_GENERATE_FAIL=1 and call /api/generate?fail=1
# Either path throws after deduct so refund_credit writes ledger reason 失败退回.
FORCE_GENERATE_FAIL=
FORCE_GENERATE_FAIL_SECRET=
